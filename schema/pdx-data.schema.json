{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDX dashboard data model (window.PDX_DATA in src/data/pdx-data.js)",
  "description": "Generated by scripts/build-data.js. Keys of the root object are hazard ids (e.g. cholera, fvd).",
  "type": "object",
  "additionalProperties": { "$ref": "#/$defs/hazard" },
  "$defs": {
    "hazard": {
      "type": "object",
      "required": ["id", "name", "pillars", "questions", "rounds", "countries"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "source": { "type": "string" },
        "pillars": { "type": "array", "items": { "type": "object", "required": ["n", "num", "id", "short", "name"],
          "properties": { "n": { "type": "integer", "description": "1-based index used everywhere else" }, "num": { "type": "string" }, "id": { "type": "string", "description": "CategoryCode" }, "short": { "type": "string" }, "name": { "type": "string" } } } },
        "questions": { "type": "object", "description": "Keyed by pillar n. Each item is [SN, text, weight].",
          "additionalProperties": { "type": "array", "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }, { "type": "number" }] } } },
        "rounds": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}(-Q[1-4])?$" } },
        "countries": { "type": "array", "items": { "$ref": "#/$defs/country" } },
        "lib": { "type": "object", "description": "Regional action library: { pillarN: [action, ...] }" },
        "reportActs": { "type": "object", "description": "Country report actions: { countryId: { pillarN: [action, ...] } }" },
        "reportYear": { "type": ["string", "null"] },
        "tracker": { "type": "array", "items": { "type": "object", "properties": { "id": {}, "c": { "type": "string" }, "p": { "type": "integer" }, "a": { "type": "string" }, "src": { "type": "string" }, "owner": { "type": "string" }, "due": { "type": "string" }, "st": { "enum": ["todo", "progress", "blocked", "done"] } } } },
        "evidence": { "type": "array", "items": { "type": "object", "properties": { "c": { "type": "string" }, "p": { "type": "integer" }, "q": { "type": "string" }, "round": { "type": "string" }, "st": { "enum": ["verified", "pending", "missing", "rejected"] }, "file": { "type": ["string", "null"] }, "up": { "type": ["string", "null"] } } } }
      }
    },
    "country": {
      "type": "object",
      "required": ["id", "name", "code", "a"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" },
        "iso": { "type": ["string", "null"], "description": "ISO 3166 numeric, used by the map" },
        "code": { "type": "string", "description": "ISO3" },
        "a": { "type": "object", "description": "Assessments keyed by DataPeriod",
          "additionalProperties": { "type": "object", "required": ["ans", "sc", "ov"], "properties": {
            "ans": { "type": "object", "description": "{ SN: 1|0 }", "additionalProperties": { "enum": [0, 1] } },
            "sc": { "type": "array", "description": "Pillar scores (%) in pillar order; null = not assessed", "items": { "type": ["integer", "null"] } },
            "ov": { "type": ["integer", "null"], "description": "Overall weighted score (%)" } } } }
      }
    }
  }
}
